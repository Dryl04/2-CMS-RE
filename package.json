{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts scripts/*.test.ts",
    "backend:build": "npm --prefix backend run prisma:generate && npm --prefix backend run build",
    "backend:test": "npm --prefix backend run test",
    "backend:test:e2e": "npm --prefix backend run test:e2e",
    "migrate:export-supabase": "bash ./scripts/export-supabase.sh",
    "migrate:export-supabase:rest": "node --experimental-strip-types ./scripts/export-supabase-rest.ts",
    "migrate:transform-export": "node --experimental-strip-types ./scripts/transform-export.ts",
    "migrate:import-postgres": "bash ./scripts/import-postgres.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "ci-check": "npm run lint && npm run build",
    "setup:themes": "node setup-themes-simple.js",
    "db:push": "bash ./scripts/supabase-db-push-smart.sh",
    "db:bundle": "bash ./scripts/build-migrations-bundle.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.57.4",
    "browser-image-compression": "^2.0.2",
    "daisyui": "^4.12.24",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
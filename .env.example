# =============================================================
# .env.example — CMS RE
# Copier ce fichier en .env et remplir les valeurs
# =============================================================

# === PostgreSQL ===
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=cms_password
POSTGRES_DB=cms_db
DATABASE_URL=postgresql://cms_user:cms_password@localhost:5432/cms_db

# === NestJS Backend ===
PORT=3000
NODE_ENV=development

# === JWT Auth ===
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# === CORS ===
# Plusieurs origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,https://monsite.com,https://www.monsite.com

# === Storage ===
STORAGE_TYPE=local
UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_PATH=/uploads

# === Cloudflare R2 (only when STORAGE_TYPE=r2) ===
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=media
# R2_PUBLIC_URL=https://your-public-r2-domain.example.com

# === Frontend (Vite) ===
VITE_API_URL=http://localhost:3001
